{
  "model_name": "XGBoost (tuned)",
  "model_type": "XGBClassifier",
  "hyperparameters": {
    "n_estimators": 400,
    "max_depth": 3,
    "learning_rate": 0.03
  },
  "features_in_order": [
    "gender",
    "height",
    "weight",
    "ap_hi",
    "ap_lo",
    "cholesterol",
    "gluc",
    "smoke",
    "alco",
    "active",
    "age_years",
    "bmi",
    "pulse_pressure"
  ],
  "preprocessing": "StandardScaler fitted on the training set only (saved in final_model.joblib)",
  "random_seed": 42,
  "decision_threshold": 0.5,
  "split": "60/20/20 stratified train/validation/test, random_state=SEED",
  "validation_scores": {
    "Accuracy": 0.7375,
    "Precision": 0.7514,
    "Recall": 0.7015,
    "F1": 0.7256
  }
}
